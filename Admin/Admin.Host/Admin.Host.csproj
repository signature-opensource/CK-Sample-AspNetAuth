<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>CK.Sample.Admin</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Admin.App\Admin.App.csproj" />
    <ProjectReference Include="..\Admin.Builder\Admin.Builder.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <!-- The builder runs during the build and writes the generated code: the default glob of the source files has already
       been evaluated (on a clean build, it misses it). The generated files are included just before the compilation. -->
  <Target Name="IncludeGeneratedCode" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="$(MSBuildProjectDirectory)/$StObjGen/**/*.cs" />
      <Compile Include="$(MSBuildProjectDirectory)/$StObjGen/**/*.cs" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- The Angular application is built by its own tool chain (see the README). -->
    <Compile Remove="Clients/**" />
    <Content Remove="Clients/**" />
    <None Remove="Clients/**" />
  </ItemGroup>
</Project>
