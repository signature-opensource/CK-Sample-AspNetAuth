{
  // The SPA and its "/.cris" endpoints share this origin (no CORS).
  "Urls": "http://localhost:5302",

  "CK-AppIdentity": {
    "FullName": "Sample/$Admin",
    // This application uses an AuthCenter (CK.AppIdentity.Cris.AuthCenter.Remote).
    "Local": { "AllowFeatures": "AuthCenter" },
    "Parties": [
      {
        "PartyName": "$AuthCenter",
        // This back-office's AuthCenter (the remote that allows the feature): the session operations and the administration
        // commands are dispatched to it, its keys verify the tokens.
        "AllowFeatures": "AuthCenter",
        "Address": "tcp:127.0.0.1:37300",
        // The AuthCenter's key is pinned at the first connection (a demo: production pins it explicitly).
        "AutoTrustKey": "Once"
      }
    ]
  },

  "Logging": { "LogLevel": { "Default": "Warning" } },
  "CK-Monitoring": {
    "GlobalDefaultFilter": "Debug",
    "GrandOutput": { "Handlers": { "Console": true, "TextFile": { "Path": "Text" } } }
  }
}
