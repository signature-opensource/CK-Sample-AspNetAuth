<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>CK.Sample.Admin</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The Remote side of the AuthCenter feature: this back-office is the second remote of the Backend. -->
    <PackageReference Include="CK.AppIdentity.AuthCenter.Remote" Version="3.0.0-0.cris-auth.1.ci.171" />
    <PackageReference Include="CK.AppIdentity.Hosting" Version="3.0.0-0.cris-auth.1.ci.48" />
    <PackageReference Include="CK.AspNet" Version="24.0.0-0.cris-auth.1.ci.58" />
    <!-- The "HttpEndpoint" feature: the web server of this party (Local:HttpEndpoint). -->
    <PackageReference Include="CK.AppIdentity.HttpEndpoint" Version="24.0.0-0.cris-auth.1.ci.58" />
    <!-- The HTTP side of the authentication and the Basic login form (the administrators sign in with their password). -->
    <PackageReference Include="CK.Cris.AspNet.Authentication" Version="3.0.0-0.cris-auth.1.ci.121" />
    <PackageReference Include="CK.Ng.Cris.AspNet.Authentication.Basic" Version="3.0.0-0.cris-auth.1.ci.121" />
    <!-- The user management: the users of a workspace, their banishment, their invitation. Its commands are handled by the
         AuthCenter (dispatched to it, with the user's proof). -->
    <PackageReference Include="CK.Ng.Admin.UserManagement" Version="3.0.0-0.cris-auth.1.ci.90" />
    <PackageReference Include="CK.Ng.Admin.UserManagement.UserBanned" Version="3.0.0-0.cris-auth.1.ci.90" />
    <PackageReference Include="CK.Ng.Admin.UserManagement.UserInvitation" Version="3.0.0-0.cris-auth.1.ci.90" />
    <PackageReference Include="CK.Ng.UserProfile.PreferredCulture" Version="3.0.0-0.cris-auth.1.ci.107" />
    <PackageReference Include="CK.Ng.UserProfile.UserBanned" Version="3.0.0-0.cris-auth.1.ci.107" />
    <!-- The approval page of the System (app-identity/enlist): the Admin hosts the "Enlistment" route; it handles the approval
         itself (it checks the operator at the Critical level) and sends it down to the holder of the pending approval. -->
    <PackageReference Include="CK.Ng.AppIdentity.Enlistment" Version="3.0.0-0.cris-auth.1.ci.90" />
    <PackageReference Include="CK.AppIdentity.Enlistment" Version="3.0.0-0.cris-auth.1.ci.171" />
    <!-- The application shell (side bar, top bar with the UserInfoBox). -->
    <PackageReference Include="CK.Ng.Zorro.BackOffice" Version="3.0.0-0.cris-auth.1.ci.80" />
    <!-- Serves the client application (app.MapClients()): its dev server in Development, its "dist" otherwise. -->
    <PackageReference Include="CK.TS.AspNet.Clients" Version="3.0.1-0.cris-auth.0.ci.41" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Sample.Shared\Sample.Shared.csproj" />
  </ItemGroup>
</Project>
