{
  // The AuthCenter serves no HTTP endpoint (the fronts use the AppIdentity channel): a fixed local port avoids the 5000 default.
  "Urls": "http://127.0.0.1:5301",

  "CK-AppIdentity": {
    "FullName": "Sample/$AuthCenter",
    "AllowFeatures": "AuthCenter",
    // The fronts connect here.
    "ListeningAddress": [ "tcp:127.0.0.1:37300" ],
    "AuthCenter": {
      "SessionLifetime": "1.00:00:00",
      "Oidc": {
        // The public demo server of Duende IdentityServer, with its public test client (a known, risk-free secret):
        // log in as bob / bob. Its first login creates the user "Bob-Smith" (SampleAccountCreation, named from the
        // "name" claim that the demo server returns from its UserInfo endpoint only).
        "Duende": {
          "Authority": "https://demo.duendesoftware.com",
          "ClientId": "interactive.confidential",
          "ClientSecret": "secret",
          "Scopes": "openid profile email",
          "GetClaimsFromUserInfoEndpoint": true,
          "AllowAccountCreation": true,
          "CallbackUrls": [ "http://localhost:5300/.auth/oidc/callback" ]
        }
        // Other schemes (a real provider, with a real secret) go in the user-secrets of this application (see the README).
      }
    },
    "Parties": [
      {
        "PartyName": "$Front",
        // The front's key is pinned at its first connection (a demo: production pins it explicitly).
        "AutoTrustKey": "Once"
      }
    ]
  },

  "Demo": {
    "AlbertPassword": "pass"
    // To bind Albert to your own account at a provider, set "OidcScheme" and "OidcSub" in the user-secrets
    // ("OidcScheme": "Google", "OidcSub": "<your sub at the provider>").
  },

  "Logging": { "LogLevel": { "Default": "Warning" } },
  "CK-Monitoring": {
    "GlobalDefaultFilter": "Debug",
    "GrandOutput": { "Handlers": { "Console": true, "TextFile": { "Path": "Text" } } }
  }
}
