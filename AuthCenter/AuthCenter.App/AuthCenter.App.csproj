<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>CK.Sample.AuthCenter</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The Local side of the AuthCenter feature (this application IS the AuthCenter): sessions, tokens, the operations of its remotes,
         their caller party and the verification of the user's proof. -->
    <PackageReference Include="CK.AppIdentity.Cris.AuthCenter.Local" Version="3.0.0-0.cris-auth.0.ci.46" />
    <!-- The OpenID Connect scheme family ("Package First": its "AuthCenter:Oidc" section requires it). -->
    <PackageReference Include="CK.AppIdentity.Cris.AuthCenter.Oidc" Version="3.0.0-0.cris-auth.0.ci.46" />
    <!-- The passkey (WebAuthn) scheme family: the ceremonies and their verification ("AuthCenter:Passkey" section). -->
    <PackageReference Include="CK.AppIdentity.Cris.AuthCenter.Passkey" Version="3.0.0-0.cris-auth.0.ci.46" />
    <PackageReference Include="CK.AppIdentity.Hosting" Version="3.0.0-0.cris-auth.0.ci.7" />
    <PackageReference Include="CK.AspNet" Version="24.0.0-0.cris-auth.0.ci.5" />
    <!-- The login providers: Basic (user name and password), Oidc, Passkey, Weak (passwordless operators, Unsafe level). -->
    <PackageReference Include="CK.DB.User.UserPassword" Version="31.0.0-0.cris-auth.0.ci.15" />
    <PackageReference Include="CK.DB.User.UserOidc" Version="31.0.0-0.cris-auth.0.ci.19" />
    <PackageReference Include="CK.DB.User.UserPasskey" Version="0.0.0-0.cris-auth.0.ci.10" />
    <PackageReference Include="CK.DB.Actor.WeakActor" Version="3.0.0-0.cris-auth.0.ci.12" />
    <!-- The PartyActor registrar: every party (this AuthCenter, its remotes) gets its PartyActorId (CK.tPartyActor). -->
    <PackageReference Include="CK.DB.AppIdentity" Version="3.0.0-0.cris-auth.0.ci.46" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Sample.Shared\Sample.Shared.csproj" />
  </ItemGroup>
</Project>
