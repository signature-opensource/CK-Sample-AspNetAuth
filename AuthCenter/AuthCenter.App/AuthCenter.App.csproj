<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>CK.Sample.AuthCenter</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The AuthCenter feature: sessions, tokens, the relay of the fronts. -->
    <PackageReference Include="CK.AppIdentity.Cris.AuthCenter" Version="2.0.3-0.cris-auth.0.ci.15" />
    <!-- The OpenID Connect scheme family ("Package First": its "AuthCenter:Oidc" section requires it). -->
    <PackageReference Include="CK.AppIdentity.Cris.AuthCenter.Oidc" Version="2.0.3-0.cris-auth.0.ci.15" />
    <!-- The passkey (WebAuthn) scheme family: the ceremonies and their verification ("AuthCenter:Passkey" section). -->
    <PackageReference Include="CK.AppIdentity.Cris.AuthCenter.Passkey" Version="2.0.3-0.cris-auth.0.ci.15" />
    <PackageReference Include="CK.AppIdentity.Hosting" Version="2.0.2-0.cris-auth.0.ci.2" />
    <PackageReference Include="CK.AspNet" Version="23.0.2-0.cris-auth.0.ci.2" />
    <!-- The login providers: Basic (user name and password), Oidc, Passkey, Weak (passwordless operators, Unsafe level). -->
    <PackageReference Include="CK.DB.User.UserPassword" Version="30.0.3-0.cris-auth.0.ci.7" />
    <PackageReference Include="CK.DB.User.UserOidc" Version="30.0.3-0.cris-auth.0.ci.10" />
    <PackageReference Include="CK.DB.User.UserPasskey" Version="0.0.0-0.cris-auth.0.ci.4" />
    <PackageReference Include="CK.DB.Actor.WeakActor" Version="2.0.3-0.cris-auth.0.ci.6" />
  </ItemGroup>
</Project>
