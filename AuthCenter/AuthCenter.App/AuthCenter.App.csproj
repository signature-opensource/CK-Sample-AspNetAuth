<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>CK.Sample.AuthCenter</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The Local side of the AuthCenter feature (this application IS the AuthCenter): sessions, tokens, the operations of its remotes,
         their caller party and the verification of the user's proof. -->
    <PackageReference Include="CK.AppIdentity.Cris.AuthCenter.Local" Version="3.0.0-0.cris-auth.0.ci.64" />
    <!-- The OpenID Connect scheme family ("Package First": its "AuthCenter:Oidc" section requires it). -->
    <PackageReference Include="CK.AppIdentity.Cris.AuthCenter.Oidc" Version="3.0.0-0.cris-auth.0.ci.64" />
    <!-- The passkey (WebAuthn) scheme family: the ceremonies and their verification ("AuthCenter:Passkey" section). -->
    <PackageReference Include="CK.AppIdentity.Cris.AuthCenter.Passkey" Version="3.0.0-0.cris-auth.0.ci.64" />
    <PackageReference Include="CK.AppIdentity.Hosting" Version="3.0.0-0.cris-auth.0.ci.9" />
    <PackageReference Include="CK.AspNet" Version="24.0.0-0.cris-auth.0.ci.6" />
    <!-- The login providers: Basic (user name and password), Oidc, Passkey, Weak (passwordless operators, Unsafe level). -->
    <PackageReference Include="CK.DB.User.UserPassword" Version="31.0.0-0.cris-auth.0.ci.23" />
    <PackageReference Include="CK.DB.User.UserOidc" Version="31.0.0-0.cris-auth.0.ci.27" />
    <PackageReference Include="CK.DB.User.UserPasskey" Version="0.0.0-0.cris-auth.0.ci.15" />
    <PackageReference Include="CK.DB.Actor.WeakActor" Version="3.0.0-0.cris-auth.0.ci.17" />
    <!-- The PartyActor registrar: every party (this AuthCenter, its remotes) gets its PartyActorId (CK.tPartyActor). -->
    <PackageReference Include="CK.DB.AppIdentity" Version="3.0.0-0.cris-auth.0.ci.64" />
    <!-- The server side of the fronts' features: the commands of the Front's profile page and of the Admin's user
         management are handled here, where the database is (dispatched by the fronts, with the user's proof). -->
    <PackageReference Include="CK.UserProfile" Version="3.0.0-0.cris-auth.0.ci.30" />
    <PackageReference Include="CK.UserProfile.UserPassword.Lost" Version="3.0.0-0.cris-auth.0.ci.30" />
    <PackageReference Include="CK.UserManagement" Version="3.0.0-0.cris-auth.0.ci.12" />
    <PackageReference Include="CK.UserManagement.UserBanned" Version="3.0.0-0.cris-auth.0.ci.12" />
    <PackageReference Include="CK.UserManagement.UserInvitation" Version="3.0.0-0.cris-auth.0.ci.12" />
    <PackageReference Include="CK.Cris.Workspace" Version="18.0.0-0.cris-auth.0.ci.11" />
    <!-- Their database: the workspaces (and their zones, ACLs), the names, the preferred culture, the e-mails, the
         banishments, the invitations and the temporary passwords. -->
    <PackageReference Include="CK.DB.Workspace" Version="18.0.0-0.cris-auth.0.ci.11" />
    <PackageReference Include="CK.DB.User.NamedUser" Version="31.0.0-0.cris-auth.0.ci.17" />
    <PackageReference Include="CK.DB.User.PreferredCulture" Version="3.0.0-0.cris-auth.0.ci.17" />
    <PackageReference Include="CK.DB.Actor.ActorEMail" Version="31.0.0-0.cris-auth.0.ci.17" />
    <PackageReference Include="CK.DB.User.UserBanned" Version="4.0.0-0.cris-auth.0.ci.13" />
    <PackageReference Include="CK.DB.UserInvitation" Version="3.0.0-0.cris-auth.0.ci.11" />
    <PackageReference Include="CK.DB.User.UserPassword.Reset" Version="31.0.0-0.cris-auth.0.ci.23" />
    <!-- The application's queries (User/UserQueries, WorkspaceUsers/WorkspaceUsersQueries) and the batch's transaction. -->
    <PackageReference Include="CK.SqlServer.Dapper" Version="18.0.0-0.cris-auth.0.ci.8" />
    <PackageReference Include="CK.SqlServer.Transaction" Version="14.0.2-0.cris-auth.0.ci.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Sample.Shared\Sample.Shared.csproj" />
  </ItemGroup>
</Project>
