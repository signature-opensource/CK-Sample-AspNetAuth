<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>CK.Sample.Backend</RootNamespace>
    <UserSecretsId>CK-Sample-Backend</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Backend.App\Backend.App.csproj" />
    <ProjectReference Include="..\Backend.Builder\Backend.Builder.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <!-- The builder runs during the build and writes the generated code: the default glob of the source files has already
       been evaluated (on a clean build, it misses it). The generated files are included just before the compilation. -->
  <Target Name="IncludeGeneratedCode" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="$(MSBuildProjectDirectory)/$StObjGen/**/*.cs" />
      <Compile Include="$(MSBuildProjectDirectory)/$StObjGen/**/*.cs" />
    </ItemGroup>
  </Target>
</Project>
