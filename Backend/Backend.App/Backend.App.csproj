<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>CK.Sample.Backend</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Local side of the AuthCenter feature (this application IS the Backend): sessions, tokens, the operations of its remotes,
         their caller party and the verification of the user's proof. -->
    <PackageReference Include="CK.AppIdentity.AuthCenter.Local" Version="3.0.0-0.cris-auth.1.ci.168" />
    <!-- The OpenID Connect scheme family ("Package First": its "AuthCenter:Oidc" section requires it). -->
    <PackageReference Include="CK.AppIdentity.AuthCenter.Oidc" Version="3.0.0-0.cris-auth.1.ci.168" />
    <!-- The passkey (WebAuthn) scheme family: the ceremonies and their verification ("AuthCenter:Passkey" section). -->
    <PackageReference Include="CK.AppIdentity.AuthCenter.Passkey" Version="3.0.0-0.cris-auth.1.ci.168" />
    <PackageReference Include="CK.AppIdentity.Hosting" Version="3.0.0-0.cris-auth.1.ci.46" />
    <!-- The login providers: Basic (user name and password), Oidc, Passkey, Weak (passwordless operators, Unsafe level). -->
    <PackageReference Include="CK.DB.User.UserPassword" Version="31.0.0-0.cris-auth.1.ci.52" />
    <PackageReference Include="CK.DB.User.UserOidc" Version="31.0.0-0.cris-auth.1.ci.59" />
    <PackageReference Include="CK.DB.User.UserPasskey" Version="0.0.0-0.cris-auth.1.ci.43" />
    <PackageReference Include="CK.DB.Actor.WeakActor" Version="3.0.0-0.cris-auth.1.ci.43" />
    <!-- The server side of the fronts' features: the commands of the Front's profile page and of the Admin's user
         management are handled here, where the database is (dispatched by the fronts, with the user's proof). -->
    <PackageReference Include="CK.UserProfile" Version="3.0.0-0.cris-auth.1.ci.105" />
    <PackageReference Include="CK.UserProfile.UserPassword.Lost" Version="3.0.0-0.cris-auth.1.ci.105" />
    <PackageReference Include="CK.UserManagement" Version="3.0.0-0.cris-auth.1.ci.64" />
    <PackageReference Include="CK.UserManagement.UserBanned" Version="3.0.0-0.cris-auth.1.ci.64" />
    <PackageReference Include="CK.UserManagement.UserInvitation" Version="3.0.0-0.cris-auth.1.ci.64" />
    <PackageReference Include="CK.Cris.Workspace" Version="18.0.0-0.cris-auth.1.ci.38" />
    <!-- Their database: the workspaces (and their zones, ACLs), the names, the preferred culture, the e-mails, the
         banishments, the invitations and the temporary passwords. -->
    <PackageReference Include="CK.DB.Workspace" Version="18.0.0-0.cris-auth.1.ci.38" />
    <PackageReference Include="CK.DB.User.NamedUser" Version="31.0.0-0.cris-auth.1.ci.44" />
    <PackageReference Include="CK.DB.User.PreferredCulture" Version="3.0.0-0.cris-auth.1.ci.44" />
    <PackageReference Include="CK.DB.Actor.ActorEMail" Version="31.0.0-0.cris-auth.1.ci.45" />
    <PackageReference Include="CK.DB.User.UserBanned" Version="4.0.0-0.cris-auth.1.ci.41" />
    <PackageReference Include="CK.DB.UserInvitation" Version="3.0.0-0.cris-auth.1.ci.56" />
    <PackageReference Include="CK.DB.User.UserPassword.Reset" Version="31.0.0-0.cris-auth.1.ci.52" />
    <!-- The application's queries (User/UserQueries, WorkspaceUsers/WorkspaceUsersQueries) and the batch's transaction. -->
    <PackageReference Include="CK.SqlServer.Dapper" Version="18.0.0-0.cris-auth.1.ci.30" />
    <PackageReference Include="CK.SqlServer.Transaction" Version="15.0.0-0.cris-auth.1.ci.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Sample.Shared\Sample.Shared.csproj" />
  </ItemGroup>
</Project>
