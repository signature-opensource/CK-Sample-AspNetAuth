{
  "CK-AppIdentity": {
    // A development configuration: its environment is fixed, whatever the run mode of the host (the parties inherit it).
    "FullName": "Sample/Auth3/$Worker/#Dev",
    "Parties": [
      {
        "PartyName": "$Backend",
        "Address": "tcp:127.0.0.1:37300",
        // The Worker trusts the Backend it is configured to reach at its first contact (a trust on first use). The Backend
        // doesn't trust the Worker ("AutoTrustKey": "Never" on its "$Worker"): until an operator approves it on the
        // approval page of the System, the Worker logs the enlistment URL and the approval code at each attempt.
        "AutoTrustKey": "Once"
      }
    ]
  },

  "Logging": { "LogLevel": { "Default": "Warning" } },
  "CK-Monitoring": {
    "GlobalDefaultFilter": "Debug",
    "GrandOutput": { "Handlers": { "Console": true, "TextFile": { "Path": "Text" } } }
  }
}
