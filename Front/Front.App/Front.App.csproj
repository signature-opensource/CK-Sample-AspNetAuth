<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>CK.Sample.Front</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The front side of the AuthCenter feature: the relay of the session commands, the token reader. -->
    <PackageReference Include="CK.AppIdentity.Cris.AuthCenter" Version="2.0.1-0.cris-auth.0.ci.29" />
    <PackageReference Include="CK.AppIdentity.Hosting" Version="2.0.1-0.cris-auth.0.ci.3" />
    <PackageReference Include="CK.AspNet" Version="23.0.1-0.cris-auth.0.ci.1" />
    <!-- The HTTP front of the authentication and the Angular client (with the Basic login form). -->
    <PackageReference Include="CK.Cris.AspNet.Authentication" Version="2.0.1-0.cris-auth.0.ci.12" />
    <PackageReference Include="CK.Ng.Cris.AspNet.Authentication.Basic" Version="2.0.1-0.cris-auth.0.ci.12" />
    <PackageReference Include="CK.IO.Authentication.Weak" Version="2.0.1-0.cris-auth.0.ci.10" />
  </ItemGroup>
</Project>
