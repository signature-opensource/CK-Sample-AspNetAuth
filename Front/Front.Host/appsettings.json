{
  // The SPA and its "/.cris" endpoints share this origin (no CORS).
  "Urls": "http://localhost:5300",

  "CK-AppIdentity": {
    "FullName": "Sample/$Front",
    "AllowFeatures": "AuthCenter",
    "Parties": [
      {
        "PartyName": "$AuthCenter",
        // This front's AuthCenter: the session commands are relayed to it, its keys verify the tokens.
        "AuthCenter": "true",
        "Address": "tcp:127.0.0.1:37300",
        // The AuthCenter's key is pinned at the first connection (a demo: production pins it explicitly).
        "AutoTrustKey": "Once"
      }
    ]
  },

  "Logging": { "LogLevel": { "Default": "Warning" } },
  "CK-Monitoring": {
    "GlobalDefaultFilter": "Debug",
    "GrandOutput": { "Handlers": { "Console": true, "TextFile": { "Path": "Text" } } }
  }
}
