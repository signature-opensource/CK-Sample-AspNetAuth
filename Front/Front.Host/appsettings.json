{
  // The SPA and its "/.cris" endpoints share this origin (no CORS).
  "Urls": "http://localhost:5300",

  "CK-AppIdentity": {
    // A development configuration: its environment is fixed, whatever the run mode of the host (the parties inherit it).
    "FullName": "Sample/$Front/#Dev",
    // This application is a remote of an AuthCenter (CK.AppIdentity.Cris.AuthCenter.Remote).
    "Local": { "AllowFeatures": "AuthCenterRemote" },
    "Parties": [
      {
        "PartyName": "$Backend",
        // This front's AuthCenter (the remote that allows "AuthCenter"): the session operations are dispatched to it,
        // its keys verify the tokens.
        "AllowFeatures": "AuthCenter",
        "Address": "tcp:127.0.0.1:37300",
        // The AuthCenter's key is pinned at the first connection (a demo: production pins it explicitly).
        "AutoTrustKey": "Once"
      }
    ]
  },

  "Logging": { "LogLevel": { "Default": "Warning" } },
  "CK-Monitoring": {
    "GlobalDefaultFilter": "Debug",
    "GrandOutput": { "Handlers": { "Console": true, "TextFile": { "Path": "Text" } } }
  }
}
