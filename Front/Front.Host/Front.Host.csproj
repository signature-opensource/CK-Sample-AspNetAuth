<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>CK.Sample.Front</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Front.App\Front.App.csproj" />
    <ProjectReference Include="..\Front.Builder\Front.Builder.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <!-- The builder runs during the build and writes the generated code: the default glob of the source files has already
       been evaluated (on a clean build, it misses it). The generated files are included just before the compilation. -->
  <Target Name="IncludeGeneratedCode" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="$StObjGen/**/*.cs" />
      <Compile Include="$(MSBuildProjectDirectory)/$StObjGen/**/*.cs" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- The Angular application is built by its own tool chain (see the README). -->
    <Compile Remove="Clients/**" />
    <Content Remove="Clients/**" />
    <None Remove="Clients/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Development: the requests that the host does not handle are forwarded to the Angular dev server (hot reload on the
         same origin as in production). -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>
</Project>
