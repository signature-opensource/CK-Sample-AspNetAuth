<Setup>
  <!-- The BinPath's Path (Front.App's output) and ProjectPath (the Front.Host folder) are set by the CKomposableAppBuilder. -->
  <Aspect Type="CK.Setup.TypeScriptAspectConfiguration, CK.TypeScript" />
  <BinPaths>
    <BinPath>
      <!-- The two client applications of the Front host. Their Name gives their project ("Clients/{Name}") and the TypeFilterName
           of the types they exchange with this host ("TypeScript{Name}"); their Kind gives their request path; app.MapClients()
           serves them (in Development, by their dev server on their DevServerPort). -->
      <TypeScript>
        <Multiple>
          <!-- The application (the authentication, the profile, the home page), served at "/". -->
          <TypeScript Name="App" Kind="DefaultApp" DevServerPort="4200" />
          <!-- A client application without authentication, served at "/mini-app/": it sends the IFrontInfoQCommand. It lists
               its packages: it gets the Cris client package (and what it requires), not the App's pages, authentication and
               styles. -->
          <TypeScript Name="MiniApp" Kind="App" DevServerPort="4201">
            <Types>
              <Type Name="CK.Ng.Cris.AspNet.CrisAspNetPackage, CK.Ng.Cris.AspNet" />
              <Type Name="CK.Sample.Front.IFrontInfoQCommand, Front.App" />
            </Types>
          </TypeScript>
        </Multiple>
      </TypeScript>
    </BinPath>
  </BinPaths>
</Setup>
