<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>CK.Sample.Front</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The Remote side of the AuthCenter feature (this application is a remote of Auth3): the token reader, the user's proof
         and the encryption of the sensitive fields for Auth3. -->
    <PackageReference Include="CK.AppIdentity.AuthCenter.Remote" Version="4.0.0-0.uc.0.ci.53" />
    <PackageReference Include="CK.AppIdentity.Hosting" Version="3.0.0-0.uc.0.ci.150" />
    <PackageReference Include="CK.AspNet" Version="25.0.0-0.uc.0.ci.46" />
    <!-- The "HttpEndpoint" feature: the web server of this party (Local:HttpEndpoint). -->
    <PackageReference Include="CK.AppIdentity.HttpEndpoint" Version="25.0.0-0.uc.0.ci.46" />
    <!-- The HTTP side of the authentication and the Angular client (the Basic and Weak login forms and the passkey buttons, with
         their endpoint handlers: this application executes the session commands, Auth3 their operations). -->
    <PackageReference Include="CK.Cris.AspNet.Authentication" Version="3.0.0-0.uc.0.ci.184" />
    <PackageReference Include="CK.Ng.Cris.AspNet.Authentication.Basic" Version="3.0.0-0.uc.0.ci.184" />
    <PackageReference Include="CK.Ng.Cris.AspNet.Authentication.Passkey" Version="3.0.0-0.uc.0.ci.184" />
    <PackageReference Include="CK.Ng.Cris.AspNet.Authentication.Weak" Version="3.0.0-0.uc.0.ci.184" />
    <!-- The profile page and its "Sign-in methods" tab: the password, the passkeys and the linked accounts. Their commands are
         handled by Auth3 (dispatched to it, with the user's proof). -->
    <PackageReference Include="CK.Ng.UserProfile" Version="3.0.0-0.uc.0.ci.184" />
    <PackageReference Include="CK.Ng.UserProfile.UserPassword" Version="3.0.0-0.uc.0.ci.184" />
    <PackageReference Include="CK.Ng.UserProfile.UserPasskey" Version="3.0.0-0.uc.0.ci.184" />
    <PackageReference Include="CK.Ng.UserProfile.UserOidc" Version="3.0.0-0.uc.0.ci.184" />
    <!-- The application shell (side bar, top bar with the UserInfoBox) and the public page (where a weak actor lands). -->
    <PackageReference Include="CK.Ng.Zorro.BackOffice" Version="3.0.0-0.uc.0.ci.150" />
    <PackageReference Include="CK.Ng.PublicPage" Version="3.0.1-0.uc.0.ci.93" />
    <!-- Serves the client applications (app.MapClients()): their dev server in Development, their "dist" otherwise. -->
    <PackageReference Include="CK.TS.AspNet.Clients" Version="3.0.1-0.uc.0.ci.109" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Sample.Shared\Sample.Shared.csproj" />
  </ItemGroup>
</Project>
