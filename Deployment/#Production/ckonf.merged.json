            "DefaultDatabaseConnectionString": "Compile"
          },
          "DefaultDatabaseConnectionString": {
            "$SECRET": "Auth3:Database"
          }
        }
      },
      "App": {
        "CrisExecutionHost": {
          "ParallelRunnerCount": 2
        },
        "Defaults": {
          "Transport": {
            "ListeningAddress": [
              "tcp:0.0.0.0:37300"
            ]
          }
        },
        "Local": {
          "AuthCenter": {
            "SessionLifetime": "1.00:00:00",
            "Oidc": {
              "Schemes": {
                "Duende": {
                  "Authority": "https://demo.duendesoftware.com",
                  "ClientId": "interactive.confidential",
                  "ClientSecret": "secret",
                  "Scopes": "openid profile email",
                  "GetClaimsFromUserInfoEndpoint": true,
                  "AllowAccountCreation": true
                }
              }
            },
            "Passkey": {
              "RpName": "CK Sample",
              "RpId": "sample.example.com"
            }
          },
          "MailSender": {
            "MailKit": {
              "Senders": {
                "NoReply": {
                  "SendEmail": true,
                  "UsePickupDirectory": false,
                  "Host": "smtp.sample.example.com",
                  "From": "noreply@sample.example.com"
                }
              }
            }
          }
        }
      }
    },
    "Front": {
      "RootPath": "Front",
      "App": {
        "Local": {
          "PartyClient": {
            "App": {
              "NgApp": true,
              "Hosting": {
                "RequestPath": "/",
                "DevServerPort": 4200
              }
            },
            "MiniApp": {
              "Types": [
                "CK.Ng.Cris.AspNet.CrisAspNetPackage, CK.Ng.Cris.AspNet",
                "CK.Sample.Front.IFrontInfoQCommand, Auth3.Front.App",
                "CK.TS.Angular.NgAppClientFeature, CK.TS.Angular",
                "CK.TypeScript.HostingClientFeature, CK.TS.AspNet.Clients"
              ],
              "NgApp": true,
              "Hosting": {
                "DevServerPort": 4201
              }
            }
          },
          "HttpEndpoint": {
            "Urls": "http://*:5300"
          },
          "KeyManagement": {
            "EnlistTicket": {
              "$SECRET?": "Enlist:Front"
            }
          }
        }
      }
    },
    "Admin": {
      "RootPath": "Admin",
      "App": {
        "Local": {
          "PartyClient": {
            "App": {
              "NgApp": true,
              "Hosting": {
                "RequestPath": "/",
                "DevServerPort": 4300
              }
            }
          },
          "HttpEndpoint": {
            "Urls": "http://*:5302"
          },
          "KeyManagement": {
            "EnlistTicket": {
              "$SECRET?": "Enlist:Admin"
            }
          }
        }
      }
    },
    "Worker": {
      "RootPath": "Worker",
      "App": {
        "CK-Monitoring": {
          "GrandOutput": {
            "Handlers": {
              "TextFile": {
                "Path": "Text/{Name}"
              }
            }
          }
        },
        "InstanceCount": 3,
        "MaxInstanceCount": 6,
        "Local": {
          "KeyManagement": {
            "EnlistTicket": {
              "$SECRET?": "Enlist:Worker-{Name}"
            }
          }
        }
      }
    },
    "Worker2": {
      "RootPath": "Worker2",
      "App": {
        "Parties": [
          {
            "DomainName": "Sample/Auth3/Customers/{Name}",
            "PartyName": "${Name}",
            "InstanceCount": 0,
            "MaxInstanceCount": 5
          }
        ],
        "Local": {
          "AuthCenterRemote": {
            "Party": "Sample/Auth3/$Auth3/#Production"
          },
          "KeyManagement": {
            "EnlistTicket": {
              "$SECRET?": "Enlist:Worker2"
            }
          }
        }
      }
    }
  },
  "Links": [
