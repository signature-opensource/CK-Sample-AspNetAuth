      "Link": {
        "Address": "tcp:auth3.sample.example.com:37300",
        "KeyManagement": {
          "AutoTrustKey": "Never"
        }
      }
    },
    {
      "From": "$Worker2",
      "To": "$Auth3",
      "Link": {
        "Address": "tcp:auth3.sample.example.com:37300"
      }
    },
    {
      "From": "$Auth3",
      "To": "$Front",
      "Link": {
        "AuthCenterRemote": true,
        "KeyManagement": {
          "AutoTrustKey": "Never"
        }
      }
    },
    {
      "From": "$Auth3",
      "To": "$Admin",
      "Link": {
        "AuthCenterRemote": true,
        "KeyManagement": {
          "AutoTrustKey": "Never"
        }
      }
    },
    {
      "From": "$Auth3",
      "To": "$Worker-{Name}",
      "Link": {
        "KeyManagement": {
          "AutoTrustKey": "Never"
        }
      }
    },
    {
      "From": "$Auth3",
      "To": "$Worker2",
      "Link": {
        "KeyManagement": {
          "AutoTrustKey": "Never"
        }
      }
    }
  ],
  "Environment": "#Production"
}
