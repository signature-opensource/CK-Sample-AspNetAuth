// Generated from ckonf.json, Deployment/#Production/ckonf.json (from the root of the solution): do not edit.
{
  "Domain": "Sample/Auth3",
  "GlobalDomainPrefix": "Sample",
  "Defaults": {
    "App": {
      "Logging": {
        "LogLevel": {
          "Default": "Warning"
        }
      },
      "CK-Monitoring": {
        "GlobalDefaultFilter": "Debug",
        "GrandOutput": {
          "Handlers": {
            "Console": true,
            "TextFile": {
              "Path": "Text"
            }
          }
        }
      }
    }
  },
  "$configurator": {
    "World": "https://github.com/signature-opensource/CK-Stack",
    "Version": "2026.11.24.1-0.uc.0.ci.0"
  },
  "Deployment": {
    "AppContexts": [
      "Front",
      "Admin",
      "Worker",
      "Worker2"
    ],
    "Publish": {
      "RuntimeIdentifier": "linux-x64"
    },
    "Apps": {
      "$Worker2": {
        "Publish": {
          "SelfContained": true,
          "PublishSingleFile": true
        }
      }
    }
  },
  "AppContexts": {
    "Auth3": {
      "RootPath": "Auth3",
      "Aspects": {
