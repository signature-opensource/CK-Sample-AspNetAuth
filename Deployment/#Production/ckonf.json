{
  // The "#Production" deployment of the sample: an overlay of the central ckonf.json (a JSON Merge Patch: an object merges,
  // null removes, any other value, an array included, replaces). Its domain is the central one ("Sample/Auth3"), its
  // environment is the name of its folder: the full name of each party is "Sample/Auth3/$<App>/#Production".
  // It writes the values per deployment (the "$PER_DEPLOYMENT" of the central file, the addresses and the URLs): the build
  // refuses to inherit them. Its merged configuration is ckonf.merged.json, next to it (generated: do not edit).
  // Its assets are built by Deployment/GenerateAssets.cs (CK.AppDeployment): one published host per deployed builder.
  // Auth3 is not deployed: its build sets up its database (the SQL layer can't generate the scripts yet).
  "Deployment": {
    "Builders": [ "Front/Auth3.Front.Builder", "Admin/Auth3.Admin.Builder", "Worker/Auth3.Worker.Builder", "Worker2/Auth3.Worker2.Builder" ],
    // The MSBuild properties of the publication of the hosts (applied as-is), then the ones of an App over them.
    "Publish": { "RuntimeIdentifier": "linux-x64" },
    "Apps": { "Auth3.Worker2": { "Publish": { "SelfContained": true, "PublishSingleFile": true } } }
  },
  "Builders": {
    "Auth3/Auth3.Auth3.Builder": {
      // The database of the deployment: a secret (its value is the configuration key "Secrets:Auth3:Database" of the host).
      "Aspects": { "SqlServer": { "DefaultDatabaseConnectionString": { "$SECRET": "Auth3:Database" } } },
      "App": {
        "Defaults": { "Transport": { "ListeningAddress": [ "tcp:0.0.0.0:37300" ] } },
        "Local": {
          "AuthCenter": {
            "Passkey": { "RpId": "sample.example.com" }
          },
          "MailSender": {
            "MailKit": {
              "NoReply": {
                "SendEmail": true,
                "UsePickupDirectory": false,
                "PickupDirectory": null,
                "Host": "smtp.sample.example.com",
                "From": "noreply@sample.example.com"
              }
            }
          }
        },
        // No demo data in production.
        "Demo": null
      }
    },
    // No key is trusted on first use in production (the links below): every party linked to Auth3 starts with its
    // pre-authorized enlistment ticket (an optional secret, given at its first start only). The ticket carries the anchor
    // of Auth3, and Auth3 trusts the key that proves it. The Admin's ticket comes first, opened on Auth3 with
    // "ckey ticket open Sample/Auth3/$Admin/#Production" (the approval page is the Admin's: it isn't running yet); the
    // others are opened on the approval page ("Expect a party") or with ckey.
    "Front/Auth3.Front.Builder": {
      "App": {
        "Local": {
          "HttpEndpoint": { "Urls": "http://*:5300" },
          "KeyManagement": { "EnlistTicket": { "$SECRET?": "Enlist:Front" } }
        }
      }
    },
    "Admin/Auth3.Admin.Builder": {
      "App": {
        "Local": {
          "HttpEndpoint": { "Urls": "http://*:5302" },
          "KeyManagement": { "EnlistTicket": { "$SECRET?": "Enlist:Admin" } }
        }
      }
    },
    // The size of the fleet of workers (a value per deployment): 3 configured instances, 3 more dynamic ones at most.
    // Each instance may start with its pre-authorized enlistment ticket (an optional secret, given at its first start
    // only: "Secrets__Enlist__Worker-2"): Auth3 trusts its key at once, no approval code.
    "Worker/Auth3.Worker.Builder": {
      "App": {
        "InstanceCount": 3,
        "MaxInstanceCount": 6,
        "Local": { "KeyManagement": { "EnlistTicket": { "$SECRET?": "Enlist:Worker-{Name}" } } }
      }
    },
    "Worker2/Auth3.Worker2.Builder": {
      "App": {
        "Local": {
          "AuthCenterRemote": { "Party": "Sample/Auth3/$Auth3/#Production" },
          // The anchor of Auth3 comes with the pre-authorized enlistment ticket of Worker2 (an optional secret, given at
          // its first start only: "Secrets__Enlist__Worker2"): the ticket carries the checkpoint of Auth3, Auth3 trusts
          // the key of Worker2 at once (no approval code). An operator opens it on the approval page ("Expect a party")
          // or with "ckey ticket open Sample/Auth3/$Worker2/#Production" on Auth3.
          "KeyManagement": { "TrustAnchors": null, "EnlistTicket": { "$SECRET?": "Enlist:Worker2" } }
        }
      }
    }
  },
  // The links of production: Auth3 is reached at its host name, no key is trusted on first use.
  "Links": [
    { "From": "$Front", "To": "$Auth3", "Link": { "AuthCenterRemote": true, "Address": "tcp:auth3.sample.example.com:37300", "KeyManagement": { "AutoTrustKey": "Never" } } },
    { "From": "$Admin", "To": "$Auth3", "Link": { "AuthCenterRemote": true, "Address": "tcp:auth3.sample.example.com:37300", "KeyManagement": { "AutoTrustKey": "Never" } } },
    { "From": "$Worker-{Name}", "To": "$Auth3", "Link": { "Address": "tcp:auth3.sample.example.com:37300", "KeyManagement": { "AutoTrustKey": "Never" } } },
    { "From": "$Worker2", "To": "$Auth3", "Link": { "Address": "tcp:auth3.sample.example.com:37300" } },
    { "From": "$Auth3", "To": "$Front", "Link": { "AuthCenterRemote": true, "KeyManagement": { "AutoTrustKey": "Never" } } },
    { "From": "$Auth3", "To": "$Admin", "Link": { "AuthCenterRemote": true, "KeyManagement": { "AutoTrustKey": "Never" } } },
    { "From": "$Auth3", "To": "$Worker-{Name}", "Link": { "KeyManagement": { "AutoTrustKey": "Never" } } },
    { "From": "$Auth3", "To": "$Worker2", "Link": { "KeyManagement": { "AutoTrustKey": "Never" } } }
  ]
}
