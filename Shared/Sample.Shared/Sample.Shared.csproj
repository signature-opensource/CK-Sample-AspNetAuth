<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>CK.Sample</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- What the hosts share: a party command handled by every party (IWhoAmIQCommand). -->
    <PackageReference Include="CK.Cris.Authentication" Version="3.0.0-0.cris-auth.0.ci.70" />
    <PackageReference Include="CK.AppIdentity.Abstractions" Version="3.0.0-0.cris-auth.0.ci.9" />
    <!-- The application's Poco leaves (IUserProfile, ICombinedWorkspaceUser): the AuthCenter materializes them, the
         fronts read them. Every party knows the same Poco, with the same properties. -->
    <PackageReference Include="CK.IO.UserProfile" Version="3.0.0-0.cris-auth.0.ci.29" />
    <PackageReference Include="CK.IO.UserProfile.Workspace" Version="18.0.0-0.cris-auth.0.ci.10" />
    <PackageReference Include="CK.IO.User.PreferredCulture" Version="3.0.0-0.cris-auth.0.ci.16" />
    <PackageReference Include="CK.IO.User.UserPassword.Reset" Version="31.0.0-0.cris-auth.0.ci.22" />
    <PackageReference Include="CK.IO.User.UserBanned" Version="4.0.0-0.cris-auth.0.ci.12" />
    <PackageReference Include="CK.IO.UserManagement.UserBanned" Version="3.0.0-0.cris-auth.0.ci.11" />
    <PackageReference Include="CK.IO.UserManagement.UserInvitation" Version="3.0.0-0.cris-auth.0.ci.11" />
  </ItemGroup>
</Project>
