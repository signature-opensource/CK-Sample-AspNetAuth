<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>CK.Sample</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- What the hosts share: a party command handled by every party (IWhoAmIQCommand). -->
    <PackageReference Include="CK.Cris.Authentication" Version="3.0.0-0.uc.0.ci.172" />
    <PackageReference Include="CK.AppIdentity.Abstractions" Version="3.0.0-0.uc.0.ci.133" />
    <!-- The application's Poco leaves (IUserProfile, ICombinedWorkspaceUser): Auth3 materializes them, the
         fronts read them. Every party knows the same Poco, with the same properties. -->
    <PackageReference Include="CK.IO.UserProfile" Version="3.0.0-0.uc.0.ci.171" />
    <PackageReference Include="CK.IO.UserProfile.Workspace" Version="18.0.0-0.uc.0.ci.81" />
    <PackageReference Include="CK.IO.User.PreferredCulture" Version="3.0.0-0.uc.0.ci.87" />
    <PackageReference Include="CK.IO.User.UserPassword.Reset" Version="31.0.0-0.uc.0.ci.94" />
    <PackageReference Include="CK.IO.User.UserBanned" Version="4.0.0-0.uc.0.ci.83" />
    <PackageReference Include="CK.IO.UserManagement.UserBanned" Version="3.0.0-0.uc.0.ci.118" />
    <PackageReference Include="CK.IO.Admin" Version="3.0.0-0.uc.0.ci.118" />
    <PackageReference Include="CK.IO.UserManagement.UserInvitation" Version="3.0.0-0.uc.0.ci.118" />
  </ItemGroup>
</Project>
